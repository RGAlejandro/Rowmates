# Postgres connection used by Prisma (CLI + app)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rowmates?schema=public"

# Clerk — `npx clerk@latest init --accountless` writes temporary dev keys to .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# TMDB — free API Read Access Token from https://www.themoviedb.org/settings/api
# Leave empty (or set TMDB_MOCK=1) to use the offline fixture catalogue.
TMDB_API_READ_TOKEN=
TMDB_MOCK=

# Public base URL, used for share links and OG images
NEXT_PUBLIC_APP_URL=http://localhost:3000
